# ==============================================================================
# ORBINEXGLOBAL TRAVEL PLATFORM - THIRD-PARTY LIVE API CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FLIGHTS API (Amadeus Self-Service)
# Free Quota: 2,000 requests/month (Sandbox Test Environment)
# Portal: https://developers.amadeus.com/
# ------------------------------------------------------------------------------
AMADEUS_CLIENT_ID=your_amadeus_api_key_here
AMADEUS_CLIENT_SECRET=your_amadeus_api_secret_here
AMADEUS_ENV=test # Change to 'production' when going live

# ------------------------------------------------------------------------------
# 2. LIVE FLIGHT STATUS & RADAR (AviationStack)
# Free Quota: 100 requests/month
# Portal: https://aviationstack.com/
# ------------------------------------------------------------------------------
AVIATIONSTACK_API_KEY=your_aviationstack_key_here

# ------------------------------------------------------------------------------
# 3. HOTELS API (Booking.com via RapidAPI)
# Free Quota: Free testing subscription available
# Portal: https://rapidapi.com/tipsters/api/booking-com
# ------------------------------------------------------------------------------
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=booking-com.p.rapidapi.com

# ------------------------------------------------------------------------------
# 4. LIVE FOREX RATES (ExchangeRate-API)
# Free Quota: 1,500 requests/month
# Portal: https://www.exchangerate-api.com/
# ------------------------------------------------------------------------------
EXCHANGERATE_API_KEY=your_exchangerate_key_here

# ------------------------------------------------------------------------------
# 5. DESTINATION WEATHER FORECAST (OpenWeatherMap)
# Free Quota: 1,000 calls/day
# Portal: https://openweathermap.org/api
# ------------------------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweather_key_here
